# Dependencies
node_modules/

# Build artifacts. bin/ holds generated output (the compiled bin/caret-native
# and its bin/ui sibling) EXCEPT bin/caret, the committed entrypoint shim that
# every install ships (EXC-643). dist/ is the generated run-from-source bundle
# (shipped via npm `files`, never committed).
bin/*
!bin/caret
ui/dist/
dist/
# Build-generated embed manifest (scripts/generate-ui-manifest.ts, run by
# .mise/tasks/build-bin) — emitted from ui/dist/, never hand-edited.
src/ui-manifest.generated.ts

# rumdl cache (rumdl also self-ignores this via a nested .gitignore)
.rumdl_cache/

# Throwaway Phase-0 contract spike (never committed)
spike/

# Ad-hoc architecture write-up (informal, never committed)
.archdiag/

# Playwright artifacts (failure traces/screenshots can capture rendered plan
# text — they stay local, never committed)
test-results/
playwright-report/
playwright/.cache/
.last-run.json

# Logs / OS cruft
*.log
.DS_Store

# Nested worktrees (parity with the repo root)
.claude/worktrees/

# caret's CLAUDE.md is intentionally checked in — it is the routing index for
# docs/agents/. Force-track it even when a global core.excludesFile ignores
# CLAUDE.md (a common personal-dotfiles default).
!/CLAUDE.md
