#!/usr/bin/env bash
#MISE description="Check caret's service unit against a real supervisor: verify macos | verify linux [shell]"
#
# Hand-run only, deliberately: nothing here joins preflight or CI. The launchd contract
# src/service/launchd-manager.ts is written against needs launchctl's `gui/<uid>` domain,
# which exists only inside a real GUI login session, and the systemd contract
# src/service/systemd-manager.ts is written against needs a booted Linux, which no CI lane
# caret has can supply — an environment that has to be maintained to stay green is one
# that rots, so this is a tool you reach for, not a gate that reaches for you.
#
# Unlike every other task here this is not a thin forwarder into the caret tasks CLI: the
# whole job is `container`, `launchctl` and one script, with no flags worth a CLI, so
# `mise run verify --help` is mise's own help rather than a CLI's. It still sources the
# preamble, because the unit and the plist are generated by running caret's own TypeScript.
# Fresh-clone guard (scripts/bootstrap.sh); `|| exit 1` is its caller contract.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../../scripts/bootstrap.sh" || exit 1
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# `bun -e` below resolves @/ from the repo's tsconfig, which it finds from the cwd.
cd "$here"

# No `local` in either body: the EXIT trap runs after the function has returned, and under
# `set -u` a variable it reads that has gone out of scope kills the cleanup.
verify_macos() {
  if [ "$#" -gt 0 ]; then
    printf 'mise run verify macos: unexpected argument %s (the checks take none)\n' "$1" >&2
    exit 2
  fi

  # Never LAUNCHD_LABEL: the checks disable, kickstart and boot this label out, and the
  # developer's own caret agent has to come out of the run untouched.
  label=dev.excessive.caret-verify
  uid="$(id -u)"
  target="gui/$uid/$label"

  if [ "$(uname)" != Darwin ]; then
    printf 'mise run verify macos needs macOS — there is no launchctl here.\n' >&2
    exit 1
  fi
  if ! launchctl print "gui/$uid" >/dev/null 2>&1; then
    printf 'mise run verify macos: no gui/%s domain — run it from a login session, not over ssh.\n' "$uid" >&2
    exit 1
  fi

  # The whole run's world: the plist, the launcher it names, and the HOME the agent gets.
  home="$(mktemp -d)"
  plist="$home/$label.plist"
  cleanup() {
    launchctl bootout "$target" >/dev/null 2>&1 || true
    # A `launchctl disable` outlives the job it named, so without this the throwaway label
    # stays opted out in the per-user database and the next run starts disabled; the
    # `=> enabled` row it leaves is permanent — launchctl has no way to unset one.
    launchctl enable "$target" >/dev/null 2>&1 || true
    rm -rf "$home"
  }
  trap cleanup EXIT
  # A run killed before its trap leaves the agent loaded, which would fail the bootstrap
  # check rather than report the stale job it really is.
  launchctl bootout "$target" >/dev/null 2>&1 || true

  cp "$here/bin/caret-launcher" "$home/caret-launcher"

  # The real builder emits the plist and its ProgramArguments is the shipped
  # bin/caret-launcher, so the checks run against what install() would write and what it
  # would start; only the label, the paths and the HOME are the harness's. Passed as env
  # vars rather than interpolated: the body is single-quoted so bash leaves its TypeScript
  # alone, which means $home cannot reach it any other way.
  CARET_VERIFY_HOME="$home" CARET_VERIFY_LABEL="$label" bun -e '
    import { buildLaunchdPlist } from "@/service/launchd.ts";
    import { SERVICE_TERMINAL_EXIT_STATUS, serviceEnvironment } from "@/service/manager.ts";

    const home = process.env.CARET_VERIFY_HOME;
    process.stdout.write(
      buildLaunchdPlist({
        launcherPath: home + "/caret-launcher",
        label: process.env.CARET_VERIFY_LABEL,
        workingDirectory: "/",
        // Every WORLD_VAR, not HOME alone: the plist overrides nothing it does not name, so
        // a stray launchctl setenv of CLAUDE_CONFIG_DIR would resolve the real caret install
        // under this throwaway HOME. Keep the roots in step with where
        // scripts/macos/verify.sh plants the fake one. No apostrophes or backticks in here:
        // the body is single-quoted, and bash reads both as its own.
        environment: serviceEnvironment({
          HOME: home,
          CLAUDE_CONFIG_DIR: home + "/.claude",
          XDG_STATE_HOME: home + "/.local/state",
          XDG_CONFIG_HOME: home + "/.config",
          XDG_CACHE_HOME: home + "/.cache",
          XDG_DATA_HOME: home + "/.local/share",
        }),
        terminalExitStatus: SERVICE_TERMINAL_EXIT_STATUS,
      }),
    );
  ' >"$plist"

  # Read out of the source rather than restated in the script: moving SUPERVISOR_WINDOW_MS
  # moves what the respawn checks are allowed to take.
  window_ms="$(bun -e '
    import { SUPERVISOR_WINDOW_MS } from "@/daemon/lifecycle.ts";
    process.stdout.write(String(SUPERVISOR_WINDOW_MS));
  ')"

  # The real agent's label, read rather than restated: the opt-out near miss asserts that
  # this run's disabled throwaway label does not satisfy the real one's pattern, and a
  # hand-copied label would quietly stop colliding and pass on nothing.
  real_label="$(bun -e '
    import { LAUNCHD_LABEL } from "@/service/manager.ts";
    process.stdout.write(LAUNCHD_LABEL);
  ')"

  CARET_VERIFY_HOME="$home" CARET_VERIFY_LABEL="$label" CARET_VERIFY_PLIST="$plist" \
    CARET_VERIFY_REAL_LABEL="$real_label" CARET_VERIFY_WINDOW_MS="$window_ms" \
    bash "$here/scripts/macos/verify.sh"
}

verify_linux() {
  image=caret-linux
  uid=1000
  home=/home/caret

  mode="${1:-verify}"
  case "$mode" in
  shell | verify) ;;
  *)
    printf 'mise run verify linux: unknown mode %s (want: shell, or nothing for the checks)\n' "$mode" >&2
    exit 2
    ;;
  esac

  if ! command -v container >/dev/null; then
    printf 'mise run verify linux needs Apple container on PATH: https://github.com/apple/container\n' >&2
    exit 1
  fi

  container build -t "$image" -f "$here/scripts/linux/Containerfile" "$here/scripts/linux"

  # --cap-add ALL is what lets systemd be PID 1 at all: without CAP_SYS_ADMIN it cannot
  # mount /run and exits before reaching a target.
  tmp="$(mktemp -d)"
  cid=""
  cleanup() {
    [ -n "$cid" ] && container stop "$cid" >/dev/null 2>&1
    rm -rf "$tmp"
  }
  trap cleanup EXIT
  cid="$(container run -d --rm --cap-add ALL "$image")"

  # Lingering is what starts user@1000.service, and the user bus it opens is the thing every
  # check below runs against. Polled because `container run -d` returns before systemd has
  # reached a target that can answer.
  for _ in $(seq 30); do
    container exec "$cid" loginctl enable-linger caret >/dev/null 2>&1 && break
    sleep 1
  done
  if ! container exec "$cid" test -S "/run/user/$uid/bus"; then
    printf 'caret: no user bus at /run/user/%s/bus — systemd never finished booting.\n' "$uid" >&2
    exit 1
  fi

  # The real builder emits the unit and its ExecStart is the shipped bin/caret-launcher, so
  # the checks run against what install() would write and what it would start; only their
  # paths are the harness's. caret's own TypeScript still never runs here — that would cost a
  # Linux node_modules for no added signal.
  unit="$tmp/caret.service"
  # Passed as an env var rather than interpolated: the body is single-quoted so bash leaves
  # its TypeScript alone, which means $home cannot reach it any other way.
  CARET_LINUX_HOME="$home" bun -e '
    import {
      SERVICE_TERMINAL_EXIT_STATUS,
      serviceEnvironment,
      SYSTEMD_UNIT,
    } from "@/service/manager.ts";
    import { buildSystemdUnit } from "@/service/systemd.ts";

    const home = process.env.CARET_LINUX_HOME;
    process.stdout.write(
      buildSystemdUnit({
        launcherPath: home + "/caret-launcher",
        label: SYSTEMD_UNIT,
        workingDirectory: "/",
        environment: serviceEnvironment({ HOME: home }),
        terminalExitStatus: SERVICE_TERMINAL_EXIT_STATUS,
      }),
    );
  ' >"$unit"
  container cp "$unit" "$cid:$home/caret.service"
  container cp "$here/scripts/linux/verify.sh" "$cid:$home/verify.sh"
  container cp "$here/bin/caret-launcher" "$cid:$home/caret-launcher"
  container exec "$cid" chown -R "$uid:$uid" "$home"
  # container cp's mode preservation is untested here — nothing else in the container is
  # exec'd directly — and a non-executable ExecStart fails as an opaque status=203/EXEC.
  container exec "$cid" chmod +x "$home/caret-launcher"

  # The user session the harness works in, spelled once: `container exec` starts a bare
  # process, so nothing hands it the two variables that name the bus.
  session=(
    container exec -u caret
    -e "XDG_RUNTIME_DIR=/run/user/$uid"
    -e "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus"
  )

  if [ "$mode" = verify ]; then
    "${session[@]}" "$cid" bash "$home/verify.sh"
  else
    # awk rather than `head -1 | cut`: head closing the pipe early would SIGPIPE systemctl,
    # and pipefail would make that the whole task's exit status.
    printf 'caret: systemd %s in %s — the unit is at %s/caret.service.\n' \
      "$(container exec "$cid" systemctl --version | awk 'NR == 1 { print $2 }')" "$cid" "$home"
    "${session[@]}" -it "$cid" bash -l
  fi
}

case "${1:-}" in
linux)
  shift
  verify_linux "$@"
  ;;
macos)
  shift
  verify_macos "$@"
  ;;
*)
  printf 'mise run verify: unknown platform %s (want: macos or linux)\n' "${1:-}" >&2
  exit 2
  ;;
esac
