#!/usr/bin/env bash
#MISE description="Smoke-test the run-from-source bundle: prewarm spawns a daemon that serves the UI"
#MISE depends=["build-bundle"]

set -euo pipefail

# Release-confidence smoke for the GitHub-based plugin install (EXC-643). Proves
# the distribution artifact — the non-compile `bun build` bundle plus the on-disk
# ui/dist beside it — works exactly as a user's npm-installed plugin would.
#
# Crucially it drives the REAL hook flow: `caret prewarm` → ensureDaemon →
# daemonCommand() spawns a DETACHED daemon child. Running the daemon in the
# foreground (an earlier version of this test) never exercised daemonCommand and
# missed that the bundle was mis-classified as a compiled binary, so the spawned
# child was `[bun, "daemon"]` (no script) and never started. The prewarm path is
# what catches that class of bug.
#
# Isolation: a temp package layout (pkg/dist/cli.js + pkg/ui/dist) the resolver
# can only serve the shipped ui/dist from, a private XDG_STATE_HOME, and a
# free CARET_PORT so the test daemon never collides with a real caret daemon on
# the default port (a foreign-world collision makes prewarm a silent no-op).

dist_dir="$PWD/dist"
ui_dist="$PWD/ui/dist"
if [ ! -f "$dist_dir/cli.js" ]; then
  echo "smoke-bundle: $dist_dir/cli.js missing (run \`mise run build-bundle\`)" >&2
  exit 1
fi
if [ ! -d "$ui_dist" ]; then
  echo "smoke-bundle: $ui_dist missing (run \`mise run build-ui\`)" >&2
  exit 1
fi

pkg_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-smoke-bundle.XXXXXX")"
state_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-smoke-bundle-state.XXXXXX")"
lock_file="$state_dir/caret/daemon.lock"
daemon_pid=""

cleanup() {
  # Kill the detached daemon the prewarm spawned (it would otherwise idle-exit
  # after ~60s); read its pid from the lock if we didn't capture it.
  if [ -z "$daemon_pid" ] && [ -f "$lock_file" ]; then
    daemon_pid="$(bun -e 'const f=Bun.file(process.argv[1]); if(await f.exists()){const l=await f.json(); if(l.pid){process.stdout.write(String(l.pid));}}' "$lock_file" 2>/dev/null || true)"
  fi
  if [ -n "$daemon_pid" ]; then kill "$daemon_pid" 2>/dev/null || true; fi
  rm -rf "$pkg_dir" "$state_dir"
}
trap cleanup EXIT

cp -R "$dist_dir" "$pkg_dir/dist"
mkdir -p "$pkg_dir/ui"
cp -R "$ui_dist" "$pkg_dir/ui/dist"

# A free TCP port so the test daemon never collides with the real one on 42718.
port="$(bun -e 'const s=Bun.serve({port:0,fetch(){return new Response("");}}); process.stdout.write(String(s.port)); s.stop(true);')"
if [ -z "$port" ]; then
  echo "smoke-bundle: could not allocate a free port" >&2
  exit 1
fi

# Drive the real hook: prewarm → ensureDaemon → daemonCommand spawns the daemon.
CARET_PORT="$port" XDG_STATE_HOME="$state_dir" bun "$pkg_dir/dist/cli.js" prewarm

# The detached daemon writes its lock after binding (~poll a couple seconds).
for _ in $(seq 1 100); do
  [ -f "$lock_file" ] && break
  sleep 0.05
done
if [ ! -f "$lock_file" ]; then
  echo "smoke-bundle: prewarm did not spawn a daemon (no lock at $lock_file)" >&2
  cat "$state_dir/caret/"*.log 2>/dev/null | tail -20 >&2 || true
  exit 1
fi
daemon_pid="$(bun -e 'const l=await Bun.file(process.argv[1]).json(); process.stdout.write(String(l.pid??""));' "$lock_file" 2>/dev/null || true)"
base="http://127.0.0.1:$port"
echo "smoke-bundle: prewarm spawned a daemon on $base (pid $daemon_pid)"

# --- GET / : 200 text/html referencing hashed assets ----------------------
index_headers="$(curl -sS -D - -o /dev/null "$base/")"
index_status="$(printf '%s' "$index_headers" | awk 'NR==1{print $2}')"
index_ctype="$(printf '%s' "$index_headers" | awk -F': ' 'tolower($1)=="content-type"{print tolower($2)}' | tr -d '\r')"
if [ "$index_status" != "200" ]; then
  echo "smoke-bundle: GET / returned $index_status (expected 200)" >&2
  exit 1
fi
case "$index_ctype" in
*text/html*) : ;;
*)
  echo "smoke-bundle: GET / Content-Type is '$index_ctype' (expected text/html)" >&2
  exit 1
  ;;
esac

index_body="$(curl -sS "$base/")"
asset_paths=()
while IFS= read -r line; do asset_paths+=("$line"); done < <(printf '%s' "$index_body" | grep -oE '/assets/[A-Za-z0-9._/-]+' | sort -u)
if [ "${#asset_paths[@]}" -eq 0 ]; then
  echo "smoke-bundle: served index references no /assets/ URLs (placeholder served? ui/dist missing?)" >&2
  printf '%s\n' "$index_body" >&2
  exit 1
fi
echo "smoke-bundle: index references ${#asset_paths[@]} hashed asset(s)"

# --- every referenced asset: 200 with a sane Content-Type -----------------
for path in "${asset_paths[@]}"; do
  headers="$(curl -sS -D - -o /dev/null "$base$path")"
  status="$(printf '%s' "$headers" | awk 'NR==1{print $2}')"
  ctype="$(printf '%s' "$headers" | awk -F': ' 'tolower($1)=="content-type"{print tolower($2)}' | tr -d '\r')"
  if [ "$status" != "200" ]; then
    echo "smoke-bundle: asset $path returned $status (expected 200)" >&2
    exit 1
  fi
  case "$ctype" in
  "" | *application/octet-stream*)
    echo "smoke-bundle: asset $path has unhelpful Content-Type '$ctype'" >&2
    exit 1
    ;;
  esac
  echo "smoke-bundle: ok 200 $path ($ctype)"
done

# --- GET /api/health : identifies caret as a production (non-dev) install --
health="$(curl -sS "$base/api/health")"
service="$(printf '%s' "$health" | bun -e 'const t=await Bun.stdin.text(); try{process.stdout.write(String(JSON.parse(t).service??""));}catch{}')"
is_dev="$(printf '%s' "$health" | bun -e 'const t=await Bun.stdin.text(); try{process.stdout.write(String(JSON.parse(t).isDev));}catch{}')"
if [ "$service" != "caret" ]; then
  echo "smoke-bundle: /api/health service is '$service' (expected caret)" >&2
  printf '%s\n' "$health" >&2
  exit 1
fi
if [ "$is_dev" != "false" ]; then
  echo "smoke-bundle: /api/health isDev is '$is_dev' (expected false — the bundle is a production install)" >&2
  exit 1
fi

echo "smoke-bundle: PASS — prewarm spawned a bundle daemon that serves the multi-asset UI"
