#!/usr/bin/env bash
#MISE description="Run tests: bare/unit = bun test, e2e = Playwright"
#MISE raw_args=true
# Fresh-clone guard (scripts/bootstrap.sh); `|| exit 1` is its caller contract.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../../scripts/bootstrap.sh" || exit 1
# raw_args hands every argument (including a bare --help) straight to the CLI, so
# `mise run test --help` shows the CLI's real help instead of mise's task help.
# Thin forwarder: the unit/e2e targets, flags, and --help live in the caret tasks
# CLI (scripts/tasks/cli.ts). `mise run test e2e` selects Playwright; bare `mise
# run test` and `mise run test unit` run the bun unit suite. `exec` replaces this
# shell with the CLI, so its exit code becomes the task's. "$@" is safe on an
# empty arg list (a special parameter, not a plain array — no set -u footgun).
exec bun scripts/tasks/cli.ts test "$@"
