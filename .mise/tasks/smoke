#!/usr/bin/env bash
#MISE description="Smoke-test the shipped UI: bare = bin + bundle, or smoke bin|bundle"
#MISE raw_args=true
# Fresh-clone guard (scripts/bootstrap.sh); `|| exit 1` is its caller contract.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../../scripts/bootstrap.sh" || exit 1
# raw_args hands every argument (including a bare --help) straight to the CLI, so
# `mise run smoke --help` shows the CLI's real help instead of mise's task help.
# Thin forwarder: the bin/bundle targets — each builds its artifact first (via the
# tasks CLI) and drives an isolated daemon — live in the caret tasks CLI
# (scripts/tasks/cli.ts). `mise run smoke bin|bundle` selects a target; bare `mise
# run smoke` runs both. "$@" is safe on an empty arg list (a special parameter,
# not a plain array — no set -u footgun).
exec bun scripts/tasks/cli.ts smoke "$@"
