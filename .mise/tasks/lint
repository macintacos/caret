#!/usr/bin/env bash
#MISE description="Check formatting and lint rules (Biome, read-only)"
#MISE raw_args=true
# raw_args hands every argument (including a bare --help) straight to the CLI, so
# `mise run lint --help` shows the CLI's real help instead of mise's task help.
# Thin forwarder: flags, defaults, and --help live in the caret tasks CLI
# (scripts/tasks/cli.ts); this task just execs its `lint` subcommand. `exec`
# replaces this shell with the CLI, so its exit code becomes the task's. "$@" is
# safe on an empty arg list (a special parameter, not a plain array — no set -u
# footgun).
exec bun scripts/tasks/cli.ts lint "$@"
