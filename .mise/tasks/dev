#!/usr/bin/env bash
#MISE description="Run the dev UI with an isolated, fake-plan-seeded caret daemon"
#MISE raw_args=true
# Fresh-clone guard (scripts/bootstrap.sh); `|| exit 1` is its caller contract.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../../scripts/bootstrap.sh" || exit 1
# raw_args hands every argument (including a bare --help) straight to the CLI, so
# `mise run dev --help` shows the CLI's real help instead of mise's task help.
# Thin forwarder: every flag, default, validation, and --help lives in the caret
# tasks CLI (scripts/tasks/cli.ts); this task just execs its `dev` subcommand.
# `exec` replaces this shell with the CLI, so Ctrl-C reaches the CLI's own signal
# handlers directly and its exit code becomes the task's. "$@" is safe on an
# empty arg list (a special parameter, not a plain array — no set -u footgun).
exec bun scripts/tasks/cli.ts dev "$@"
