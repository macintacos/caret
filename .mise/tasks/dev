#!/usr/bin/env bash
#MISE description="Run the dev UI with an isolated, fake-plan-seeded caret daemon"

set -euo pipefail

# Port mode (EXC-461): by default the daemon binds an OS-assigned ephemeral port
# (`caret daemon --ephemeral`) and this task discovers the real port from the
# daemon's lock file — so any number of `mise run dev` sessions coexist without
# clobbering each other. Set CARET_DEV_PORT to pin a fixed port instead.
daemon_cmd=(bun src/cli.ts daemon)
if [ -n "${CARET_DEV_PORT:-}" ]; then
  # Never bind the production default: a CARET_DEV_PORT of 42718 would squat on
  # an installed caret (AC5).
  if [ "$CARET_DEV_PORT" = "42718" ]; then
    echo "caret dev: CARET_DEV_PORT must differ from the production default (42718)" >&2
    exit 1
  fi
  export CARET_PORT="$CARET_DEV_PORT"
else
  daemon_cmd+=(--ephemeral)
fi
# State dir: ephemeral by default (isolated + wiped on exit, AC1/AC5/AC6). Set
# CARET_DEV_STATE_DIR to a persistent path to keep state across dev restarts —
# e.g. to exercise the daemon's on-disk persistence (remembered approve mode,
# rehydrated reviews). A persistent dir is reused and is NOT deleted on exit.
# NB: one live dev session per CARET_DEV_STATE_DIR — two sessions sharing a
# persistent dir would overwrite each other's daemon.lock (the ephemeral mktemp
# default is the supported concurrent path).
if [ -n "${CARET_DEV_STATE_DIR:-}" ]; then
  state_dir="$CARET_DEV_STATE_DIR"
  mkdir -p "$state_dir"
  persist_state=1
else
  state_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-dev.XXXXXX")"
  persist_state=0
fi
export XDG_STATE_HOME="$state_dir"
# Keep the dev daemon from idle-auto-shutting-down mid-session (AC4). This is the
# max setTimeout delay (2^31-1 ms); a larger value overflows and clamps to 1ms.
export CARET_IDLE_MS=2147483647

daemon_pid=""
driver_pid=""
vite_pid=""

# Reap the daemon, driver, and Vite, then drop the ephemeral state on exit, so a
# teardown never leaves an orphan holding the dev port or stale reviews (AC6).
cleanup() {
  for pid in "$driver_pid" "$daemon_pid" "$vite_pid"; do
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
  done
  wait 2>/dev/null || true
  # Only wipe an ephemeral (mktemp) state dir; a user-provided persistent dir
  # (CARET_DEV_STATE_DIR) is left intact so state survives across dev restarts.
  if [ "$persist_state" = 0 ]; then rm -rf "$state_dir"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# A persistent CARET_DEV_STATE_DIR may hold a stale lock from a crashed run;
# the boot about to happen writes its own. (The lock-wait below would otherwise
# read the stale port and attach the session to nothing.)
lock_file="$state_dir/caret/daemon.lock"
rm -f "$lock_file"

# Stock daemon, run from source so daemon edits are live without a rebuild.
# Local-dev only: the daemon emits NDJSON on stderr (EXC-398), so render it
# human-readable through pino-pretty (a devDependency — production caret always
# emits raw NDJSON; pino-pretty is never bundled into the binary). The
# translateTime mask keeps the records' ISO 8601 UTC time verbatim — without
# it pino-pretty re-renders time as local HH:MM:ss with no date.
"${daemon_cmd[@]}" 2> >(bunx pino-pretty --colorize --translateTime "UTC:yyyy-mm-dd'T'HH:MM:ss.l'Z'" >&2) &
daemon_pid=$!

# Discover the daemon's bound port from its lock (written after a successful
# bind), then hand it to the driver and the Vite proxy via CARET_PORT. The
# parser also requires the lock's stateDir to be OUR state dir, so a session
# can never silently attach to a foreign daemon's lock (e.g. two sessions
# pointed at one persistent CARET_DEV_STATE_DIR). Bounded wait, loud failure
# — including for a daemon that died on boot (EXC-461).
port=""
for _ in $(seq 1 100); do
  if [ -f "$lock_file" ]; then
    # Explicit exit codes (no uncaught throw): 0 + port on a usable own-world
    # lock, 1 on anything else (unreadable, foreign stateDir, bad port).
    port="$(bun -e 'try { const l = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); const ok = l.stateDir === process.argv[2] && Number.isInteger(l.port) && l.port > 0; if (!ok) process.exit(1); console.log(l.port); } catch { process.exit(1); }' "$lock_file" "$state_dir/caret" 2>/dev/null)" || port=""
    if [ -n "$port" ]; then break; fi
  fi
  if ! kill -0 "$daemon_pid" 2>/dev/null; then
    echo "caret dev: daemon exited before writing its lock — see output above" >&2
    exit 1
  fi
  sleep 0.1
done
if [ -z "$port" ]; then
  echo "caret dev: no usable lock at $lock_file (missing, foreign, or bad port) — aborting" >&2
  exit 1
fi
# An OS-assigned ephemeral port can be 42718 on Linux (its ephemeral range
# includes it): never let a dev daemon squat the production default — abort
# loudly; the EXIT trap reaps the daemon.
if [ "$port" = "42718" ]; then
  echo "caret dev: OS assigned the production default port (42718) — rerun" >&2
  exit 1
fi
export CARET_PORT="$port"
echo "caret dev: port=$CARET_PORT state=$state_dir persistent=$persist_state"

# Seed the fake plan and play the agent's protocol side (waits for health first).
# It also seeds a genuinely-new review (fresh session/id) every 15s by default —
# the manual test path for the EXC-427 notification. CARET_DEV_NEW_REVIEW_MS
# tunes the cadence; 0 disables.
bun scripts/dev/driver.ts &
driver_pid=$!

# Vite is backgrounded (not foreground/`exec`) and waited on, so a teardown
# signal reaches the trap and cleanup reaps all three children — even if the
# signal hits this script's PID alone rather than the whole process group.
cd ui
bunx vite &
vite_pid=$!
wait "$vite_pid"
