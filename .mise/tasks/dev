#!/usr/bin/env bash
#MISE description="Run the dev UI with an isolated, fake-plan-seeded caret daemon"
#USAGE flag "--notify" help="Arm the recurring extra-review seeder (EXC-427 notification path); off by default"

set -euo pipefail

# Thin process-supervision glue: this task boots and reaps the three dev
# processes (daemon + driver + Vite) and isolates their state. Every
# non-supervisory decision — port mode, lock-based port discovery, the typed
# constants — lives in scripts/dev/dev-env.ts (the bash side can't import TS),
# so "valid lock" and the magic numbers are each defined in exactly one place.

# Read the never-idle sentinel from src once (the only typed constant this
# task itself sets; DEFAULT_PORT stays fully owned by the helper).
never_idle_ms="$(bun scripts/dev/dev-env.ts never-idle-ms)"

# --- Port mode (EXC-461) ---------------------------------------------------
# By default the daemon binds an OS-assigned ephemeral port (`caret daemon
# --ephemeral`) and this task discovers the real port from the daemon's lock
# file — so any number of `mise run dev` sessions coexist without clobbering
# each other. Set CARET_DEV_PORT to pin a fixed port instead (never the
# production default — the helper rejects it so a dev session can't squat an
# installed caret).
daemon_cmd=(bun src/cli.ts daemon)
read -r port_kind fixed_port < <(bun scripts/dev/dev-env.ts port-mode "${CARET_DEV_PORT:-}")
if [ "$port_kind" = "fixed" ]; then
  export CARET_PORT="$fixed_port"
else
  daemon_cmd+=(--ephemeral)
fi

# --- State-dir lifecycle ---------------------------------------------------
# State dir: ephemeral by default (isolated + wiped on exit, AC1/AC5/AC6). Set
# CARET_DEV_STATE_DIR to a persistent path to keep state across dev restarts —
# e.g. to exercise the daemon's on-disk persistence (remembered approve mode,
# rehydrated reviews). A persistent dir is reused and is NOT deleted on exit.
# NB: one live dev session per CARET_DEV_STATE_DIR — two sessions sharing a
# persistent dir would overwrite each other's daemon.lock (the ephemeral mktemp
# default is the supported concurrent path).
if [ -n "${CARET_DEV_STATE_DIR:-}" ]; then
  state_dir="$CARET_DEV_STATE_DIR"
  mkdir -p "$state_dir"
  persist_state=1
else
  state_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-dev.XXXXXX")"
  persist_state=0
fi
export XDG_STATE_HOME="$state_dir"
# Keep the dev daemon from idle-auto-shutting-down mid-session (AC4): the
# never-idle sentinel, read above from src.
export CARET_IDLE_MS="$never_idle_ms"

daemon_pid=""
driver_pid=""
vite_pid=""

# Reap the daemon, driver, and Vite, then drop the ephemeral state on exit, so a
# teardown never leaves an orphan holding the dev port or stale reviews (AC6).
cleanup() {
  for pid in "$driver_pid" "$daemon_pid" "$vite_pid"; do
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null || true; fi
  done
  wait 2>/dev/null || true
  # Only wipe an ephemeral (mktemp) state dir; a user-provided persistent dir
  # (CARET_DEV_STATE_DIR) is left intact so state survives across dev restarts.
  if [ "$persist_state" = 0 ]; then rm -rf "$state_dir"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# A persistent CARET_DEV_STATE_DIR may hold a stale lock from a crashed run;
# the boot about to happen writes its own. (The port discovery below would
# otherwise read the stale port and attach the session to nothing.)
lock_file="$state_dir/caret/daemon.lock"
rm -f "$lock_file"

# --- Daemon ----------------------------------------------------------------
# Stock daemon, run from source so daemon edits are live without a rebuild.
# Local-dev only: the daemon emits NDJSON on stderr (EXC-398), so render it
# human-readable through pino-pretty (a devDependency — production caret always
# emits raw NDJSON; pino-pretty is never bundled into the binary). The
# translateTime mask keeps the records' ISO 8601 UTC time verbatim — without
# it pino-pretty re-renders time as local HH:MM:ss with no date.
"${daemon_cmd[@]}" 2> >(bunx pino-pretty --colorize --translateTime "UTC:yyyy-mm-dd'T'HH:MM:ss.l'Z'" >&2) &
daemon_pid=$!

# Discover the daemon's bound port from its lock (written after a successful
# bind), then hand it to the driver and the Vite proxy via CARET_PORT. The
# helper requires the lock's stateDir to be OUR state dir (so a session can
# never silently attach to a foreign daemon's lock), aborts if the daemon died
# on boot, and refuses an OS-assigned production-default port. Bounded wait,
# loud failure.
port="$(bun scripts/dev/dev-env.ts discover-port "$lock_file" "$state_dir/caret" "$daemon_pid")"
export CARET_PORT="$port"
echo "caret dev: port=$CARET_PORT state=$state_dir persistent=$persist_state"

# --- Driver + Vite ---------------------------------------------------------
# Seed the fake plan and play the agent's protocol side (waits for health first).
# The recurring extra-review seeder (a genuinely-new review every tick — the
# manual test path for the EXC-427 notification) is OFF by default. Pass
# --notify to arm it at the default cadence; CARET_DEV_NEW_REVIEW_MS tunes the
# cadence (positive ms) and 0 disables, and an explicit value always wins over
# --notify, which only fills the env from the named default when it is unset.
if [ "${usage_notify:-false}" = true ] && [ -z "${CARET_DEV_NEW_REVIEW_MS:-}" ]; then
  CARET_DEV_NEW_REVIEW_MS="$(bun scripts/dev/dev-env.ts seeder-default-ms)"
  export CARET_DEV_NEW_REVIEW_MS
fi
bun scripts/dev/driver.ts &
driver_pid=$!

# Vite is backgrounded (not foreground/`exec`) and waited on, so a teardown
# signal reaches the trap and cleanup reaps all three children — even if the
# signal hits this script's PID alone rather than the whole process group.
cd ui
bunx vite &
vite_pid=$!
wait "$vite_pid"
