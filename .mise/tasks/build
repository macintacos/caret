#!/usr/bin/env bash
#MISE description="Build the UI then the binary (build-ui -> build-bin)"
#MISE depends=["build-bin"]
# Thin forwarder: the completion line and the optional --install step live in the
# caret tasks CLI (scripts/tasks/cli.ts), which parses --install. "$@" is safe on
# an empty arg list (a special parameter, not a plain array — no set -u footgun).
exec bun scripts/tasks/cli.ts build "$@"
