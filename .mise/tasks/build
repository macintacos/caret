#!/usr/bin/env bash
#MISE description="Build the UI then the binary (build-ui -> build-bin)"
#MISE depends=["build-bin"]
#USAGE flag "--install" help="After building, install the local checkout + cycle the daemon (dev only)"

set -euo pipefail

# build-bin depends on build-ui, so this umbrella task runs both in order.
echo "caret build complete: bin/caret-native (run via the bin/caret shim)"

# --install (EXC-555): after building, delegate to install.sh's --from-local
# mode, which reuses these artifacts (no rebuild), reinstalls the plugin, and
# cycles the daemon to this build. Local-dev only — never CI. mise sets
# usage_install=true when --install is passed.
if [ "${usage_install:-}" = "true" ]; then
  scripts/install.sh --from-local
fi
