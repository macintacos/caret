#!/usr/bin/env bash
#MISE description="Smoke-test the compiled binary: serves the embedded multi-asset UI over the wire"
#MISE depends=["build"]

set -euo pipefail

# Release-confidence smoke: prove the COMPILED binary serves the UI purely from
# its embedded asset manifest (EXC-521/522), not from a dist tree on disk. Kept
# OUT of preflight on purpose — it depends on a full `bun build --compile`, which
# is too slow for the per-push gate; this is the final-validation / pre-release run.
#
# Isolating the embed takes care: ui-assets.ts's resolver has two on-disk
# fallbacks that would serve a valid UI even with a broken embed, masking the
# failure this task exists to catch. Both key off the *binary's* location, not
# the cwd — a compiled binary's import.meta.url is file:///$bunfs/root/<bin>, so
# srcDist (../ui/dist relative to it) never resolves to the repo, and besideDist
# (dirname(execPath)/ui) is the real masking source: `mise run build-bin` copies
# ui/dist to bin/ui as a safety net, so bin/caret always has a valid sibling UI.
# We neutralize besideDist by running a COPY of the binary alone in a temp dir
# with no sibling ui/ — then neither disk fallback resolves and the embedded
# manifest is the only possible asset source. (The cwd is irrelevant here.)

src_bin="$PWD/bin/caret"
if [ ! -x "$src_bin" ]; then
  echo "smoke-bin: $src_bin missing or not executable (run \`mise run build\`)" >&2
  exit 1
fi

# Isolated ephemeral state dir (its own daemon.lock + reviews) and an isolated
# dir to hold the lone binary copy — both wiped on exit.
state_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-smoke.XXXXXX")"
run_dir="$(mktemp -d "${TMPDIR:-/tmp}/caret-smoke-bin.XXXXXX")"
lock_file="$state_dir/caret/daemon.lock"
daemon_pid=""

cleanup() {
  if [ -n "$daemon_pid" ]; then kill "$daemon_pid" 2>/dev/null || true; fi
  wait 2>/dev/null || true
  rm -rf "$state_dir" "$run_dir"
}
trap cleanup EXIT

# Copy the binary into the temp dir alone — no sibling ui/ — so besideDist
# (dirname(execPath)/ui) has nothing to fall back to and the embed must serve.
bin="$run_dir/caret"
cp "$src_bin" "$bin"

# Boot the copied binary on an OS-assigned port (--ephemeral) with the isolated
# state dir. No subshell: $! is the daemon pid itself, so cleanup's kill and the
# poll loop's `kill -0` target the real process. The cwd does not affect asset
# resolution (it keys off execPath / $bunfs), so we leave this script's cwd as-is.
XDG_STATE_HOME="$state_dir" "$bin" daemon --ephemeral &
daemon_pid=$!

# Discover the bound port from the lock the daemon writes after a successful
# bind. Bounded poll: ~5s at 50ms intervals, then fail loudly.
port=""
for _ in $(seq 1 100); do
  if [ -f "$lock_file" ]; then
    port="$(bun -e 'const f=Bun.file(process.argv[1]); if(await f.exists()){const l=await f.json(); if(l.port){process.stdout.write(String(l.port));}}' "$lock_file" 2>/dev/null || true)"
    if [ -n "$port" ]; then break; fi
  fi
  if ! kill -0 "$daemon_pid" 2>/dev/null; then
    echo "smoke-bin: daemon exited before writing its lock" >&2
    exit 1
  fi
  sleep 0.05
done
if [ -z "$port" ]; then
  echo "smoke-bin: daemon did not report a port within ~5s" >&2
  exit 1
fi

base="http://127.0.0.1:$port"
echo "smoke-bin: daemon up on $base (pid $daemon_pid, state $state_dir)"

# --- GET / : 200 text/html referencing hashed assets ----------------------
index_headers="$(curl -sS -D - -o /dev/null "$base/")"
index_status="$(printf '%s' "$index_headers" | awk 'NR==1{print $2}')"
index_ctype="$(printf '%s' "$index_headers" | awk -F': ' 'tolower($1)=="content-type"{print tolower($2)}' | tr -d '\r')"
if [ "$index_status" != "200" ]; then
  echo "smoke-bin: GET / returned $index_status (expected 200)" >&2
  exit 1
fi
case "$index_ctype" in
*text/html*) : ;;
*)
  echo "smoke-bin: GET / Content-Type is '$index_ctype' (expected text/html)" >&2
  exit 1
  ;;
esac

index_body="$(curl -sS "$base/")"
# Every hashed asset URL the served index references (script src / link href
# under /assets/). If the embed were broken the binary would serve its built-in
# placeholder, which references no assets — so an empty set is itself a failure.
asset_paths=()
while IFS= read -r line; do asset_paths+=("$line"); done < <(printf '%s' "$index_body" | grep -oE '/assets/[A-Za-z0-9._/-]+' | sort -u)
if [ "${#asset_paths[@]}" -eq 0 ]; then
  echo "smoke-bin: served index references no /assets/ URLs (broken embed? placeholder served?)" >&2
  echo "--- served index ---" >&2
  printf '%s\n' "$index_body" >&2
  exit 1
fi
echo "smoke-bin: index references ${#asset_paths[@]} hashed asset(s)"

# --- every referenced asset: 200 with a sane Content-Type -----------------
for path in "${asset_paths[@]}"; do
  headers="$(curl -sS -D - -o /dev/null "$base$path")"
  status="$(printf '%s' "$headers" | awk 'NR==1{print $2}')"
  ctype="$(printf '%s' "$headers" | awk -F': ' 'tolower($1)=="content-type"{print tolower($2)}' | tr -d '\r')"
  if [ "$status" != "200" ]; then
    echo "smoke-bin: asset $path returned $status (expected 200)" >&2
    exit 1
  fi
  # A sane, non-empty Content-Type — Bun.file carries each asset's MIME, so a
  # blank or octet-stream type signals the served file lost its type mapping.
  case "$ctype" in
  "" | *application/octet-stream*)
    echo "smoke-bin: asset $path has unhelpful Content-Type '$ctype'" >&2
    exit 1
    ;;
  esac
  echo "smoke-bin: ok 200 $path ($ctype)"
done

# --- GET /api/health : identifies caret -----------------------------------
health="$(curl -sS "$base/api/health")"
service="$(printf '%s' "$health" | bun -e 'const t=await Bun.stdin.text(); try{process.stdout.write(String(JSON.parse(t).service??""));}catch{}')"
if [ "$service" != "caret" ]; then
  echo "smoke-bin: /api/health service is '$service' (expected caret)" >&2
  echo "--- health body ---" >&2
  printf '%s\n' "$health" >&2
  exit 1
fi

echo "smoke-bin: PASS — compiled binary serves the embedded multi-asset UI"
