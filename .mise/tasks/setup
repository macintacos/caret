#!/usr/bin/env bash
#MISE description="Install pinned tools, JS deps, the generated palette, e2e Chromium, and register git hooks"
#MISE raw_args=true
# raw_args hands every argument (including a bare --help) straight to the CLI, so
# `mise run setup --help` shows the CLI's real help instead of mise's task help.
# Thin forwarder: the install steps live in the caret tasks CLI
# (scripts/tasks/cli.ts). "$@" is safe on an empty arg list (a special
# parameter, not a plain array — no set -u footgun).
exec bun scripts/tasks/cli.ts setup "$@"
