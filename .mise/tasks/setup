#!/usr/bin/env bash
#MISE description="Install pinned tools, JS deps, and register git hooks"

set -euo pipefail

# `mise install` installs every tool in mise.toml; the postinstall hook then
# runs `hk install --mise` to (re)register the git hooks.
mise install
bun install
# Install the Chromium binary the Playwright e2e suite drives.
bunx playwright install chromium
