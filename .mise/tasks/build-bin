#!/usr/bin/env bash
#MISE description="Compile the single caret binary (bun build --compile)"
#MISE depends=["build-ui"]

set -euo pipefail

mkdir -p bin
# Compiles src/cli.ts (which imports ui/dist/index.html as a text asset) into a
# standalone binary. build-ui must run first so the HTML exists at compile time.
bun build --compile --outfile bin/caret src/cli.ts
# Fallback safety net: keep a copy of the UI beside the binary in case the
# embedded text asset is ever unavailable at runtime.
cp ui/dist/index.html bin/index.html
