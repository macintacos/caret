{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Lint/format everything by default, then subtract — so a new top-level dir
    // (e.g. an adapter dir) is in scope automatically instead of being silently
    // skipped until someone remembers to extend an allowlist. The exclusions are
    // build output (dist/bin), deps, and the file types Biome doesn't own here:
    // `.svelte` (svelte-check owns the UI; Biome misparses runes as unused
    // bindings) and `.css`/`.html` (hand-authored UI assets, not Biome's to
    // reformat). (hk's wider glob still routes staged files here; these excludes
    // filter them.)
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!bin",
      "!**/*.svelte",
      "!**/*.css",
      "!**/*.html",
      // Build-generated embed manifest (EXC-522): emitted under src/, which
      // biome lints — exclude the generated artifact from the lint/format gate.
      "!src/ui-manifest.generated.ts",
      // Vendored verbatim from the source-view library's core stylesheet: a
      // single ~40 KB string literal that must stay byte-identical to upstream
      // (a drift test guards it), so it is not biome's to reformat.
      "!ui/src/lib/diffview/diffsCoreStyles.ts",
      // shadcn-svelte components are copied verbatim from the registry (the `.ts`
      // barrels here; the `.svelte` bodies are already excluded above). They're
      // vendored code we re-sync with `shadcn-svelte add`, not ours to police —
      // biome-formatting them would diff against upstream on every re-copy. Our
      // own helpers (ui/src/lib/utils.ts, etc.) stay in scope (EXC-757).
      "!ui/src/lib/components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  // Import organization (EXC/import-aliases). Groups top-to-bottom, blank line
  // between each: runtime built-ins (node:/bun:), third-party packages, then our
  // own app code, then any leftover relative paths. `@core` denotes a scoped
  // package to Biome (no slash after `@`), so it is excluded from the package
  // group (`!@core/**`) and folded in with the app-code aliases (`@/`, `@/tasks`,
  // `$lib`) where it belongs — the shadowing fix. `@/tasks` needs no such carve-out:
  // it starts with `@/`, so `:ALIAS:` already groups it with the app code.
  // Bare/side-effect imports stay put
  // (sortBareImports defaults off) so CSS and polyfill order is preserved.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@core/**"],
              ":BLANK_LINE:",
              [":ALIAS:", "@core/**"],
              ":BLANK_LINE:",
              [":PATH:"]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      // Test code (specs plus the shared test/ support harness) may use
      // non-null assertions pragmatically over fixtures and probe results.
      "includes": ["**/*.test.ts", "test/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
