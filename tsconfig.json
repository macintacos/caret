{
  // The root (node/bun) program: the daemon core (src), the dev/release scripts
  // (scripts), and the unit suite (test) — which now also houses the Playwright
  // e2e suite under test/e2e/, importing from src to boot a real daemon
  // in-process. Browser-DOM types ride in via the shared base for e2e's
  // page.evaluate callbacks; @playwright/test types arrive through explicit
  // imports, never as ambient globals, so daemon code stays clear of them.
  // Shared options live in tsconfig.base.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["bun"],
    // `@/*` is the app-code alias: it resolves to this program's source root,
    // src/ (the daemon core). Every module the app owns imports its siblings
    // through it instead of a `../../` relative dance. `@core/*` also resolves to
    // src/*, but is reserved for the cross-boundary import from the browser UI
    // (see ui/tsconfig.json); the root program keeps the mapping so `bun test`
    // resolves the ui unit suite's `@core` imports identically (EXC-507).
    //
    // `@/tasks/*` grafts the dev/release tooling in scripts/tasks/ onto the same
    // `@/` namespace so those modules import each other by alias too. It is a
    // longer prefix than `@/*`, and TypeScript/bun match the most-specific prefix,
    // so `@/tasks/x` → scripts/tasks/x while `@/x` → src/x. (scripts/ shares this
    // program rather than owning a tsconfig — it is node/bun code tsc checks
    // alongside src and test, not a separate build like ui/.)
    //
    // The four wildcard entries below cover the other roots this program spans,
    // so nothing in test/ has to address a target by counting `../` hops
    // (EXC-879). They are top-level rather than grafted under `@/` on purpose:
    // `@/` means "this program's source root", and widening it to "any root"
    // would cost the one alias here with a crisp definition. `@test/*` also
    // disambiguates the two distinct support harnesses — test/support/ (bun) vs
    // test/e2e/support/ (Playwright) — which a bare `./support/x` could not.
    //
    // `@root/package.json` is exact rather than a `@root/*` wildcard because the
    // repo root is not a source root: `@root/*` would alias the whole tree at
    // once — including every root above, which already has its own alias — so it
    // would be a second spelling for all of them. One suite reads the version;
    // widen this only when a second root-level file needs it.
    "paths": {
      "@/tasks/*": ["./scripts/tasks/*"],
      "@/*": ["./src/*"],
      "@core/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@scripts/*": ["./scripts/*"],
      "@opencode/*": ["./opencode/*"],
      "@ui/*": ["./ui/*"],
      "@root/package.json": ["./package.json"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "opencode/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "bin", "ui", "spike"]
}
