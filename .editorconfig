root = true

# shfmt reads .editorconfig for shell indentation. The hk `shfmt` builtin runs
# `shfmt --apply-ignore` with no `-i` flag, so it honors these settings instead
# of defaulting to tabs — keeping the repo's existing 2-space shell style.
[*.{sh,bash}]
indent_style = space
indent_size = 2

# The extensionless mise file-tasks are bash scripts too.
[.mise/tasks/*]
indent_style = space
indent_size = 2

# So is the extensionless plugin entrypoint shim.
[bin/caret]
indent_style = space
indent_size = 2

# Biome formats the JS/TS/JSON family to 2-space (indentStyle "space" in
# biome.jsonc); .svelte rides the same convention. Mirror it here so editors
# default to spaces and don't reintroduce tab indentation (EXC-553).
[*.{ts,tsx,js,jsx,mjs,cjs,svelte,json,jsonc}]
indent_style = space
indent_size = 2
