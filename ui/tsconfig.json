{
  // The UI (browser/Svelte) program: ui/src. Adds Svelte's ambient types and
  // isolatedModules (svelte-check compiles each module in isolation). Shared
  // options live in ../tsconfig.base.json.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "isolatedModules": true,
    "types": ["bun", "svelte"],
    // `@/*` is the app-code alias: it resolves to this program's source root,
    // ui/src/ (the browser app). UI modules import their own siblings through it
    // instead of a `../../` relative dance.
    // `@core/*` resolves to the tool-agnostic core in src/ (paths are relative
    // to this config's dir, so one level up). The UI imports the wire contract
    // (src/lib/types.ts) through this alias rather than a hand-kept mirror; the vite
    // alias and root tsconfig mirror this mapping so svelte-check, the
    // vite build, and bun test agree (EXC-507).
    // `$lib/*` → ui/src/lib/*, the import prefix shadcn-svelte's copied
    // components and components.json assume. Mirrors the vite `$lib` alias so
    // svelte-check, the vite build, and bun test agree (EXC-757).
    //
    // `@ui/*` → this program's root (ui/), one level above its source root, so the
    // unit harness in ui/support/ is addressable as `@ui/support/…`.
    // `@test/*` → the bun program's test/ tree, which the
    // UI suites reach for shared polling helpers (EXC-879). Both are duplicated
    // here rather than inherited because bun resolves `paths` from the *nearest*
    // tsconfig, so ui/src/**/*.test.ts never sees the root config's mapping.
    // Unlike the aliases above these two are test-only — resolved by bun test and
    // svelte-check, never by the vite build, which does not compile *.test.ts — so
    // they are deliberately absent from vite.config.ts; mirroring them there would
    // imply vite resolves them.
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["../src/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "@ui/*": ["./*"],
      "@test/*": ["../test/*"]
    }
  },
  "include": ["src/**/*.ts", "support/**/*.ts", "*.ts"]
}
