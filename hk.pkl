amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

// Keep the amends/import version in lockstep with the `hk` version in mise.toml.
//
// caret is a Bun + TypeScript + Svelte project. Biome formats/lints the JS/TS/
// JSON; type-level checking is folded into linting via tsc (backend) and
// svelte-check (the Svelte UI, which Biome cannot parse). All three are
// read-only linter steps, so `mise run lint` and the pre-commit hook enforce
// types as well as style.
//
// Two mappings, three hooks:
//   mise run format -> the `fix` hook   -> `formatters` (write mode)
//   mise run lint   -> the `check` hook -> `formatters` + `linters`, read-only
//                      (formatter diff checks + rule/type checks), so an
//                      unformatted or tab-indented file fails the gate instead of
//                      being silently reflowed at commit time (EXC-553).
// The `pre-commit` hook runs BOTH in fix mode, so every commit stays formatted,
// clean, and type-checked.
//
// Beyond the web stack, the mappings also cover the rest of the repo: rumdl
// (Markdown format + lint), yamlfmt (YAML), taplo (TOML), shfmt + shellcheck
// (shell, incl. the extensionless .mise/tasks/* scripts), and pkl + pkl-format
// (this file).

// Formatters — rewrite files into canonical form.
local formatters = new Mapping<String, Step> {
  ["Web(Format+Imports) [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.json", "**/*.jsonc")
    // `biome check` (not `biome format`) so this step also applies the
    // organizeImports assist action configured in biome.jsonc — import grouping
    // is a formatting concern and rides with the formatter. `--linter-enabled=false`
    // keeps lint rules (and their autofixes) out of the format pass; the read-only
    // Web(Lint) step below owns those. So `mise run format` reflows + regroups
    // imports, and `mise run lint` fails on an unformatted OR mis-ordered file.
    // hk's glob is broader than biome.jsonc's `files.includes`, so a staged file
    // can land outside biome's scope; --no-errors-on-unmatched lets it no-op
    // instead of failing the hook.
    check = "biome check --linter-enabled=false --no-errors-on-unmatched {{ files }}"
    fix = "biome check --write --linter-enabled=false --no-errors-on-unmatched {{ files }}"
  }

  // Canonicalize Tailwind classes in the Svelte UI (`data-[disabled]:opacity-50`
  // -> `data-disabled:opacity-50`) via Tailwind v4's design-system API — the same
  // suggestion the editor LSP surfaces. `--css` points it at this project's theme.
  // The tool's `--check` reports suggestions but always exits 0, which forces two
  // choices: `mise run lint` can't gate on canonicity (format-only, by design), and
  // `check_first = false` is required or hk's check-then-fix would see exit-0 and
  // never rewrite.
  ["Tailwind(Canonical) [[laststance]]"] = new Step {
    glob = List("ui/src/**/*.svelte")
    check_first = false
    check = "bunx tailwind-suggest-canonical-classes --check --css ./ui/src/app.css {{ files }}"
    fix = "bunx tailwind-suggest-canonical-classes --css ./ui/src/app.css {{ files }}"
  }

  // rumdl owns Markdown — one native binary for both format and lint. The format
  // step runs `rumdl fmt` (applies fixes, formatter-style exit codes — won't fail on
  // leftover lint); the Markdown(Lint) step below enforces read-only `rumdl check`.
  // Override only `fix` — the builtin's glob (**/*.md, **/*.markdown) and its
  // check_diff = "rumdl check --diff" are inherited. Config lives in .rumdl.toml.
  //
  // The dev plan fixture is excluded here as well as in .rumdl.toml so the file
  // never reaches rumdl at all: it must stay as an agent would have written it,
  // because caret reflows it at ingest and that is what `mise run dev` is testing.
  ["Markdown(Format) [[builtins.rumdl]]"] = (Builtins.rumdl) {
    fix = "rumdl fmt {{ files }}"
    exclude = List("scripts/tasks/dev/fake-plan.md")
  }

  ["YAML(Format)     [[builtins.yamlfmt]]"] = Builtins.yamlfmt

  ["TOML(Format)     [[builtins.taplo_format]]"] = Builtins.taplo_format

  // Inherited whole: the builtin's match_any pairs the shell extensions with a
  // `types` clause, and hk resolves those types by shebang — so the extensionless
  // .mise/tasks/* forwarders and bin/caret are covered without a glob override.
  // The builtin runs `shfmt --apply-ignore` (no -i), so 2-space indent comes from
  // .editorconfig rather than a flag override.
  ["Shell(Format)    [[builtins.shfmt]]"] = Builtins.shfmt

  ["Pkl(Format)      [[builtins.pkl_format]]"] = Builtins.pkl_format
}

// Linters — read-only checks (no rewrite): Biome lint (JS/TS) plus the type
// checkers. tsc and svelte-check are whole-project commands, so they take no
// `{{ files }}` arg — a matching staged file just triggers the full check.
local linters = new Mapping<String, Step> {
  ["Web(Lint)         [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs")
    // --error-on-warnings makes warn-level rules (e.g. noNonNullAssertion,
    // noAdjacentSpacesInRegex) fail the gate instead of printing and exiting 0 —
    // so `mise run lint` and preflight surface them as failures rather than
    // silently passing. `fix` omits it so autofix still runs and never aborts on
    // a warning it can't rewrite.
    check = "biome lint --error-on-warnings --no-errors-on-unmatched {{ files }}"
    fix = "biome lint --write --no-errors-on-unmatched {{ files }}"
  }
  ["TypeScript(Check) [[tsc]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx")
    exclude = List("ui/**")
    check = "bun x tsc --noEmit"
  }
  ["Svelte(Check)     [[svelte-check]]"] = new Step {
    glob = List("ui/**/*.svelte", "ui/**/*.ts")
    check = "bash -c 'cd ui && bunx svelte-check --tsconfig ./tsconfig.json'"
  }

  // Inherited whole, same as Shell(Format) above: the builtin's shebang-driven
  // `types` clause is what reaches the extensionless .mise/tasks/* forwarders and
  // bin/caret, so no glob override is needed to cover them.
  ["Shell(Lint)       [[builtins.shellcheck]]"] = Builtins.shellcheck

  // Same rumdl binary, read-only: `rumdl check` reports violations (exit 1). In
  // pre-commit (fix=true) the inherited fix = "rumdl check --fix" auto-resolves
  // fixable lint after the formatter's `rumdl fmt`, so a commit converges in one pass.
  ["Markdown(Lint)    [[builtins.rumdl]]"] = (Builtins.rumdl) {
    check = "rumdl check {{ files }}"
    exclude = List("scripts/tasks/dev/fake-plan.md")
  }

  ["TOML(Lint)        [[builtins.taplo]]"] = Builtins.taplo

  ["Pkl(Lint)         [[builtins.pkl]]"] = Builtins.pkl
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }

  // `mise run format` — formatters only, in write mode.
  ["fix"] {
    fix = true
    steps = formatters
  }

  // `mise run lint` — formatters + linters, read-only. The hook sets no `fix`,
  // so each formatter runs its `check` command (e.g. `biome format`, never
  // --write) alongside the rule/type checks. This makes `check` agree with `fix`
  // on formatting: a tab-indented or otherwise unformatted file fails the gate
  // here instead of being silently reflowed by the pre-commit fix. (EXC-553)
  ["check"] {
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }
}
