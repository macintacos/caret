amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

// Keep the amends/import version in lockstep with the `hk` version in mise.toml.
//
// caret is a Bun + TypeScript + Svelte project. Biome formats/lints the JS/TS/
// JSON; type-level checking is folded into linting via tsc (backend) and
// svelte-check (the Svelte UI, which Biome cannot parse). All three are
// read-only linter steps, so `mise run lint` and the pre-commit hook enforce
// types as well as style.
//
// Two mappings keep the mise tasks single-purpose:
//   mise run format -> the `fix` hook   -> `formatters` (write mode)
//   mise run lint   -> the `check` hook -> `linters` (read-only rule + type checks)
// The `pre-commit` hook runs BOTH, so every commit stays formatted, clean, and
// type-checked.
//
// Beyond the web stack, the mappings also cover the rest of the repo: rumdl
// (Markdown format + lint), yamlfmt (YAML), taplo (TOML), shfmt + shellcheck
// (shell, incl. the extensionless .mise/tasks/* scripts), and pkl + pkl-format
// (this file).

// Formatters — rewrite files into canonical form.
local formatters = new Mapping<String, Step> {
  ["Web(Format)      [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.json", "**/*.jsonc")
    // hk's glob is broader than biome.jsonc's `files.includes`, so a staged file
    // can land outside biome's scope; --no-errors-on-unmatched lets it no-op
    // instead of failing the hook.
    check = "biome format --no-errors-on-unmatched {{ files }}"
    fix = "biome format --write --no-errors-on-unmatched {{ files }}"
  }

  // rumdl owns Markdown — one native binary for both format and lint. The format
  // step runs `rumdl fmt` (applies fixes, formatter-style exit codes — won't fail on
  // leftover lint); the Markdown(Lint) step below enforces read-only `rumdl check`.
  // Override only `fix` — the builtin's glob (**/*.md, **/*.markdown) and its
  // check_diff = "rumdl check --diff" are inherited. Config lives in .rumdl.toml.
  ["Markdown(Format) [[builtins.rumdl]]"] = (Builtins.rumdl) {
    fix = "rumdl fmt {{ files }}"
  }

  ["YAML(Format)     [[builtins.yamlfmt]]"] = Builtins.yamlfmt

  ["TOML(Format)     [[builtins.taplo_format]]"] = Builtins.taplo_format

  // Keep the builtin's default extensions and add the extensionless .mise/tasks/*
  // scripts. The builtin runs `shfmt --apply-ignore` (no -i), so 2-space indent
  // comes from .editorconfig rather than a flag override.
  ["Shell(Format)    [[builtins.shfmt]]"] = (Builtins.shfmt) {
    glob = List("**/*.sh", "**/*.bash", "**/*.mksh", "**/*.bats", "**/*.zsh", ".mise/tasks/*")
  }

  ["Pkl(Format)      [[builtins.pkl_format]]"] = Builtins.pkl_format
}

// Linters — read-only checks (no rewrite): Biome lint (JS/TS) plus the type
// checkers. tsc and svelte-check are whole-project commands, so they take no
// `{{ files }}` arg — a matching staged file just triggers the full check.
local linters = new Mapping<String, Step> {
  ["Web(Lint)         [[biome]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs")
    check = "biome lint --no-errors-on-unmatched {{ files }}"
    fix = "biome lint --write --no-errors-on-unmatched {{ files }}"
  }
  ["TypeScript(Check) [[tsc]]"] = new Step {
    glob = List("**/*.ts", "**/*.tsx")
    exclude = List("ui/**")
    check = "bun x tsc --noEmit"
  }
  ["Svelte(Check)     [[svelte-check]]"] = new Step {
    glob = List("ui/**/*.svelte", "ui/**/*.ts")
    check = "bash -c 'cd ui && bunx svelte-check --tsconfig ./tsconfig.json'"
  }

  // Shell lint covers the extensionless .mise/tasks/* scripts as well as *.sh.
  ["Shell(Lint)       [[builtins.shellcheck]]"] = (Builtins.shellcheck) {
    glob = List("**/*.sh", "**/*.bash", ".mise/tasks/*")
  }

  // Same rumdl binary, read-only: `rumdl check` reports violations (exit 1). In
  // pre-commit (fix=true) the inherited fix = "rumdl check --fix" auto-resolves
  // fixable lint after the formatter's `rumdl fmt`, so a commit converges in one pass.
  ["Markdown(Lint)    [[builtins.rumdl]]"] = (Builtins.rumdl) {
    check = "rumdl check {{ files }}"
  }

  ["TOML(Lint)        [[builtins.taplo]]"] = Builtins.taplo

  ["Pkl(Lint)         [[builtins.pkl]]"] = Builtins.pkl
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ...formatters
      ...linters
    }
  }

  // `mise run format` — formatters only, in write mode.
  ["fix"] {
    fix = true
    steps = formatters
  }

  // `mise run lint` — linters only (rule checks); read-only.
  ["check"] {
    steps = linters
  }
}
